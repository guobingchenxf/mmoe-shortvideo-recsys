* text=auto

# 源码与配置：统一以 LF 存储
*.py      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.txt     text eol=lf
*.example text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf
*.dockerignore text eol=lf

# Windows 批处理必须是 CRLF
*.bat     text eol=crlf

# Dockerfile 无扩展名，单独声明
Dockerfile text eol=lf

# 二进制文件不要做任何行尾转换！！！！！（已经踩坑
*.parquet binary
*.pt      binary
*.npy     binary
*.pkl     binary
*.png     binary
*.jpg     binary
*.ico     binary
