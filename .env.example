# =====================================================================
# 环境变量模板
# 用法：复制为 .env 后再修改
# =====================================================================

# Redis 连接地址。


# 模型权重路径。留空 => 使用 artifacts/models/best_mmoe.pt
MODEL_PATH=

# 在线服务监听地址与端口
API_HOST=0.0.0.0
API_PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
