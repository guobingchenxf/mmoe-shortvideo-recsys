# =====================================================================
# 环境变量模板
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
# =====================================================================

# Redis 连接地址。
# 留空 => 自动降级为「进程内内存缓存」，无需安装 Redis 即可跑通全流程。
# 示例：redis://localhost:6379/0
REDIS_URL=

# 模型权重路径。留空 => 使用 artifacts/models/best_mmoe.pt
MODEL_PATH=

# 在线服务监听地址与端口
API_HOST=0.0.0.0
API_PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
